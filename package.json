{
  "name": "nowplaying",
  "version": "1.2.0",
  "description": "Chrome で再生中の曲を、デスクトップのウィジェットと Discord に表示し、任意で自分のサーバへ送る Windows 用アプリ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/discord-test.js && node test/relay-config-test.js && node test/smtc-test.js && node test/control-test.js",
    "send": "node test/send.js",
    "dist": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "koffi": "^3.3.3",
    "ws": "^8.22.0"
  },
  "license": "MIT",
  "os": [
    "win32"
  ],
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "AliceRiver",
  "build": {
    "appId": "io.github.aliceriver.nowplaying",
    "productName": "NowPlaying",
    "files": [
      "main.js",
      "acrylic.js",
      "discord.js",
      "png.js",
      "wnp.js",
      "smtc.js",
      "smtc.ps1",
      "preload.js",
      "widget.html",
      "widget.js",
      "settings.html",
      "settings.js",
      "relay-config.js",
      "relay-preload.js",
      "relay.html",
      "relay.js",
      "control.js",
      "control.ps1"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*.node",
      "smtc.ps1",
      "control.ps1"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "NowPlaying.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice-river/Nowplaying-Agent.git"
  }
}
